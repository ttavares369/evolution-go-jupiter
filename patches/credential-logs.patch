+// Only explicit scalar diagnostics may reach either sink. In particular, never
+// invoke Error, String or Format on arbitrary objects (including device/config
+// structs). Sensitive scalar strings still must be excluded at the call site.
+func safeLogArgs(args []interface{}) []interface{} {
+	safe := make([]interface{}, len(args))
+	for i, arg := range args {
+		switch arg.(type) {
+		case nil, string, bool, int, int8, int16, int32, int64,
+			uint, uint8, uint16, uint32, uint64, float32, float64, time.Duration:
+			safe[i] = arg
+		default:
+			safe[i] = fmt.Sprintf("[redacted %T]", arg)
+		}
+	}
+	return safe
