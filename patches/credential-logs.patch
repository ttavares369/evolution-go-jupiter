+// credentialSafeORMLogger never evaluates SQL trace callbacks or formats driver
+// messages: either can contain tokens, session keys, DSNs or echoed parameters.
+// It is local to the users DB; it does not change GORM's global logger or queries.
+type credentialSafeORMLogger struct {
+	output *slog.Logger
+	level  gormlogger.LogLevel
+}
+
+// NewSafeORMLogger creates a structured diagnostic sink without SQL or payloads.
+func NewSafeORMLogger(out io.Writer, level gormlogger.LogLevel) gormlogger.Interface {
+	return credentialSafeORMLogger{
+		output: slog.New(slog.NewJSONHandler(out, nil)),
+		level:  level,
+	}
+}
+
+func (l credentialSafeORMLogger) LogMode(level gormlogger.LogLevel) gormlogger.Interface {
+	l.level = level
+	return l
+}
+
+func (l credentialSafeORMLogger) Info(ctx context.Context, _ string, _ ...interface{}) {
+	if l.level >= gormlogger.Info {
+		l.output.InfoContext(ctx, "gorm diagnostic", "event", "info")
+	}
+}
+
+func (l credentialSafeORMLogger) Warn(ctx context.Context, _ string, _ ...interface{}) {
+	if l.level >= gormlogger.Warn {
+		l.output.WarnContext(ctx, "gorm diagnostic", "event", "warning")
+	}
+}
+
+func (l credentialSafeORMLogger) Error(ctx context.Context, _ string, _ ...interface{}) {
+	if l.level >= gormlogger.Error {
+		l.output.ErrorContext(ctx, "gorm diagnostic", "event", "error")
+	}
+}
+
+func (l credentialSafeORMLogger) Trace(ctx context.Context, begin time.Time, _ func() (string, int64), err error) {
+	elapsed := time.Since(begin)
+	switch {
+	case err != nil && l.level >= gormlogger.Error:
+		l.output.ErrorContext(ctx, "gorm query", "event", "query_error", "elapsed_ms", elapsed.Milliseconds(), "error_type", fmt.Sprintf("%T", err))
+	case elapsed > 200*time.Millisecond && l.level >= gormlogger.Warn:
+		l.output.WarnContext(ctx, "gorm query", "event", "slow_query", "elapsed_ms", elapsed.Milliseconds())
+	case l.level >= gormlogger.Info:
+		l.output.InfoContext(ctx, "gorm query", "event", "query", "elapsed_ms", elapsed.Milliseconds())
+	}
+}
+
+// ParamsFilter is only used by GORM's diagnostic interpolation, not execution.
+func (l credentialSafeORMLogger) ParamsFilter(_ context.Context, _ string, _ ...interface{}) (string, []interface{}) {
+	return "[redacted SQL]", nil
+}
 
